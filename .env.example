# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-secure-random-secret-key-32-chars-min
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
PERMANENT_SESSION_LIFETIME=3600

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hospital_management_db
DB_USER=hms_user
DB_PASSWORD=hms_password_placeholder

# SQLAlchemy URL (constructed automatically from variables if not explicitly provided)
# DATABASE_URL=mysql+pymysql://hms_user:hms_password_placeholder@localhost:3306/hospital_management_db

# Initial Admin Credentials for CLI setup (Optional)
INITIAL_ADMIN_EMAIL=admin@hospital.local
INITIAL_ADMIN_PASSWORD=AdminSecurePass123!
INITIAL_ADMIN_FIRST_NAME=System
INITIAL_ADMIN_LAST_NAME=Administrator
INITIAL_ADMIN_PHONE=+1234567890
